{
	"compilerOptions": {
		"module": "Node18",
		"target": "es2023",
		"strict": true,
		"noImplicitAny": true,
		"noUnusedParameters": true,
		"noUnusedLocals": true,
		"preserveConstEnums": true,
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"declaration": true,
		"skipLibCheck": true,
		"rootDir": "src",
		"outDir": "out",
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
